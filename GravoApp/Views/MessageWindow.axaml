<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GravoApp.Views.MessageWindow"
        SizeToContent="WidthAndHeight" CanResize="False" MinWidth="320" MaxWidth="600"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="OkButton" MinWidth="80" Click="OnAccept" />
            <Button x:Name="YesButton" MinWidth="80" Click="OnAccept" />
            <Button x:Name="NoButton" MinWidth="80" IsCancel="True" Click="OnReject" />
        </StackPanel>
    </StackPanel>
</Window>
