<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GravoApp.ViewModels"
        x:Class="GravoApp.Views.WordInputWindow"
        x:DataType="vm:WordInputViewModel"
        Title="{Binding Title}"
        SizeToContent="WidthAndHeight" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="Grid.form > :is(Control)">
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Styles>
    <Grid Margin="16" ColumnDefinitions="260,24,260" RowDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="8">
            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto" Classes="form">
                <TextBlock Text="{Binding Texts[WORDS_LANGUAGE], StringFormat='{}{0}:'}" VerticalAlignment="Center" />
                <ComboBox x:Name="LanguageBox" Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                          IsEnabled="{Binding !NewLanguages}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LanguageText, Mode=TwoWay}"
                         IsEnabled="{Binding NewLanguages}"
                         MaxLength="{Binding Limits.DictionaryMainMaxLengthLanguage}" />
                <TextBlock Grid.Row="2" Text="{Binding Texts[WORDS_MAIN_LANGUAGE], StringFormat='{}{0}:'}"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding MainLanguages}"
                          SelectedItem="{Binding SelectedMainLanguage, Mode=TwoWay}"
                          IsEnabled="{Binding !NewLanguages}" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MainLanguageText, Mode=TwoWay}"
                         IsEnabled="{Binding NewLanguages}"
                         MaxLength="{Binding Limits.DictionaryMainMaxLengthMainLanguage}" />
            </Grid>
            <CheckBox Content="{Binding Texts[WORD_INPUT_NEW_LANGUAGES]}"
                      IsChecked="{Binding NewLanguages, Mode=TwoWay}" />

            <CheckBox x:Name="DirectAddCheck" Margin="0,24,0,0" Content="{Binding Texts[WORDS_DIRECT_ADD]}"
                      IsChecked="{Binding DirectAdd, Mode=TwoWay}" IsEnabled="{Binding CanDirectAdd}" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Groups}"
                      SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" IsEnabled="{Binding DirectAdd}" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding SubGroups}"
                      SelectedItem="{Binding SelectedSubGroup, Mode=TwoWay}" IsEnabled="{Binding DirectAdd}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Spacing="8">
            <TextBlock Text="{Binding Texts[WORD_INPUT_SECTION]}" FontWeight="Bold" />
            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  Classes="form">
                <TextBlock Text="{Binding Texts[WORDS_MAIN_ENTRY], StringFormat='{}{0}:'}" VerticalAlignment="Center" />
                <TextBox x:Name="MainEntryBox" Grid.Column="1" Text="{Binding MainEntry, Mode=TwoWay}"
                         MaxLength="{Binding Limits.DictionaryMainMaxLengthWordEntry}" />
                <TextBlock Grid.Row="1" Text="{Binding Texts[WORDS_PRE], StringFormat='{}{0}:'}"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Pre, Mode=TwoWay}"
                         MaxLength="{Binding Limits.DictionaryWordsMaxLengthPre}" />
                <TextBlock Grid.Row="2" Text="{Binding Texts[WORDS_SUB_ENTRY], StringFormat='{}{0}:'}"
                           VerticalAlignment="Center" />
                <TextBox x:Name="WordBox" Grid.Row="2" Grid.Column="1" Text="{Binding Word, Mode=TwoWay}"
                         MaxLength="{Binding Limits.DictionaryWordsMaxLengthWord}" />
                <TextBlock Grid.Row="3" Text="{Binding Texts[WORDS_POST], StringFormat='{}{0}:'}"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Post, Mode=TwoWay}"
                         MaxLength="{Binding Limits.DictionaryWordsMaxLengthPost}" />
                <TextBlock Grid.Row="4" Text="{Binding Texts[WORDS_MEANING], StringFormat='{}{0}:'}"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Meaning, Mode=TwoWay}"
                         MaxLength="{Binding Limits.DictionaryWordsMaxLengthMeaning}" />
                <TextBlock Grid.Row="5" Text="{Binding Texts[WORDS_ADDITIONAL_INFO], StringFormat='{}{0}:'}"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding AdditionalInfo, Mode=TwoWay}"
                         MaxLength="{Binding Limits.DictionaryWordsMaxLengthAdditionalTargetLangInfo}" />
                <TextBlock Grid.Row="6" Text="{Binding Texts[WORDS_WORD_TYPE], StringFormat='{}{0}:'}"
                           VerticalAlignment="Top" />
                <ListBox x:Name="WordTypeList" Grid.Row="6" Grid.Column="1" Height="120"
                         SelectionMode="AlwaysSelected" ItemsSource="{Binding WordTypeDisplays}"
                         SelectedIndex="{Binding SelectedWordTypeIndex, Mode=TwoWay}" />
            </Grid>
            <CheckBox Margin="100,0,0,0" Content="{Binding Texts[WORDS_IRREGULAR]}"
                      IsChecked="{Binding Irregular, Mode=TwoWay}" />
            <CheckBox Margin="100,0,0,0" Content="{Binding Texts[WORDS_MARKED]}"
                      IsChecked="{Binding Marked, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0" Spacing="8">
            <Button x:Name="AddButton" MinWidth="80" IsDefault="True" Command="{Binding AddSubEntryCommand}"
                    Content="{Binding Texts[BUTTON_ADD]}" />
            <Button x:Name="CloseButton" MinWidth="80" IsCancel="True" Command="{Binding CloseCommand}"
                    Content="{Binding Texts[BUTTON_CLOSE]}" />
        </StackPanel>
    </Grid>
</Window>
