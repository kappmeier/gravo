<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GravoApp.ViewModels"
        x:Class="GravoApp.Views.OptionsWindow"
        x:DataType="vm:OptionsViewModel"
        Title="{Binding Title}"
        SizeToContent="WidthAndHeight" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="12" MinWidth="360">
        <TextBlock Text="{Binding Texts[OPTIONS_TEST_SECTION]}" FontWeight="Bold" />
        <CheckBox Content="{Binding Texts[OPTIONS_TEST_TARGET_LANGUAGE]}"
                  IsChecked="{Binding TestTargetLanguage, Mode=TwoWay}" />
        <CheckBox Content="{Binding Texts[OPTIONS_TEST_SET_PHRASES]}"
                  IsChecked="{Binding TestSetPhrases, Mode=TwoWay}" />

        <TextBlock Text="{Binding Texts[OPTIONS_DISPLAY_SECTION]}" FontWeight="Bold" />
        <CheckBox Content="{Binding Texts[OPTIONS_SAVE_WINDOW_POSITION]}"
                  IsChecked="{Binding SaveWindowPosition, Mode=TwoWay}" />

        <TextBlock Text="{Binding Texts[OPTIONS_STRATEGIES]}" FontWeight="Bold" />
        <CheckBox Content="{Binding Texts[OPTIONS_USE_CARDS]}" IsChecked="{Binding UseCards, Mode=TwoWay}" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Texts[OPTIONS_INITIAL_VALUE]}" VerticalAlignment="Center" />
            <Button Content="−" Command="{Binding DecreaseIntervalCommand}" />
            <TextBlock Text="{Binding CardsInitialInterval}" MinWidth="40" TextAlignment="Center"
                       VerticalAlignment="Center" />
            <Button Content="+" Command="{Binding IncreaseIntervalCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding Texts[OPTIONS_CARDS_HINT]}" TextWrapping="Wrap" MaxWidth="360" />

        <Button Content="{Binding Texts[OPTIONS_COPY_CARDS]}" Command="{Binding CopyCardsCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="OkButton" MinWidth="80" IsDefault="True" Command="{Binding OkCommand}"
                    Content="{Binding Texts[BUTTON_OK]}" />
            <Button x:Name="CancelButton" MinWidth="80" IsCancel="True" Command="{Binding CancelCommand}"
                    Content="{Binding Texts[BUTTON_CANCEL]}" />
        </StackPanel>
    </StackPanel>
</Window>
