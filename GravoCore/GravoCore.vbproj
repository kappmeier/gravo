<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Gravo</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- API surface:
           CA1707: ManagementDao DB_VERSION_* constants;
           CA1725: interface/impl parameter-name mismatches
           CA1051: public fields in ManagementDao
           CA1036: DbSchemaVersion operators
           CA1001: SQLiteDataBaseOperation lifecycle
           CA1859: concrete return types on Private helpers (perf-only). -->
    <NoWarn>$(NoWarn);CA1001;CA1036;CA1051;CA1707;CA1725;CA1859</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="xls\Card.vb">
      <CustomToolNamespace></CustomToolNamespace>
    </Compile>
  </ItemGroup>

</Project>
