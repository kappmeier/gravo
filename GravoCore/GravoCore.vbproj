<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Gravo</RootNamespace>
    <TargetFramework>netstandard2.0</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Currently do not fix the following warnings as changes semantics:
           CA2201: generic Exception type in GroupsDao
           CA2208: bare ArgumentException in Checker;
           CA2218: adding GetHashCode changes hash semantics (MainEntry/TestEntry).
         API surface:
           CA1707: ManagementDao DB_VERSION_* constants;
           CA1725: interface/impl parameter-name mismatches
           CA1051: public fields in ManagementDao
           CA1036: DBVersion operators
           CA1001: SQLiteDataBaseOperation lifecycle
           CA1859: concrete return types on Private helpers (perf-only). -->
    <NoWarn>$(NoWarn);CA1001;CA1036;CA1051;CA1707;CA1725;CA1859;CA2201;CA2208;CA2218</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.SQLite" Version="1.0.110" />
    <PackageReference Include="System.Collections.Immutable" Version="1.7.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="xls\Card.vb">
      <CustomToolNamespace></CustomToolNamespace>
    </Compile>
  </ItemGroup>

</Project>
